{
  "name": "hybrid-blog-deploy",
  "private": true,
  "scripts": {
    "build": "npm --prefix hybrid-blog-app ci && npm run check:demos && npm --prefix hybrid-blog-app run build && node hybrid-blog-app/scripts/package-pages.mjs",
    "dev": "npm --prefix hybrid-blog-app run dev",
    "import:sviz": "node hybrid-blog-app/scripts/import-sviz-demo.mjs",
    "test": "npm --prefix hybrid-blog-app test",
    "sync:demos": "node hybrid-blog-app/scripts/sync-r2-demos.mjs",
    "check:demos": "node hybrid-blog-app/scripts/sync-r2-demos.mjs --check"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
