---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  getAllEntries,
  getEntrySourcePath,
} from "@/lib/content";

export const prerender = false;

const entries = await getAllEntries();

function yamlString(value: string) {
  return `"${value.replaceAll("\\", "\\\\").replaceAll("\"", "\\\"")}"`;
}

function yamlList(values: string[]) {
  return values.length > 0 ? values.map((value) => `  - ${yamlString(value)}`).join("\n") : "  - \"\"";
}

function entryToMarkdown(entry: typeof entries[number]) {
  const lines = [
    "---",
    `title: ${yamlString(entry.data.title)}`,
    `description: ${yamlString(entry.data.description)}`,
    `pubDate: ${entry.data.pubDate.toISOString().slice(0, 10)}`,
    "authors:",
    yamlList(entry.data.authors),
    "tags:",
    yamlList(entry.data.tags),
    `status: ${yamlString(entry.data.status)}`,
  ];

  if (entry.data.updatedDate) {
    lines.push(`updatedDate: ${entry.data.updatedDate.toISOString().slice(0, 10)}`);
  }

  if (entry.data.slug) lines.push(`slug: ${yamlString(entry.data.slug)}`);

  if (entry.data.cover) {
    lines.push(`cover: ${yamlString(entry.data.cover)}`);
  }

  if (entry.data.canonicalUrl) {
    lines.push(`canonicalUrl: ${yamlString(entry.data.canonicalUrl)}`);
  }

  lines.push("formats:", yamlList(entry.data.formats), "---", "", entry.body ?? "");
  return lines.join("\n");
}

const editableEntries = entries.map((entry) => ({
  id: `${entry.collection}:${entry.id}`,
  collection: entry.collection,
  slug: entry.id,
  title: entry.data.title,
  status: entry.data.status,
  sourcePath: getEntrySourcePath(entry),
  markdown: entryToMarkdown(entry),
}));
---

<BaseLayout title="编辑工作台" description="Hybrid Blog 的内容发布、编辑和草稿预览入口。">
  <section class="hero">
    <p class="eyebrow"><a href="/editor/workspace/">Editor workspace</a> / 编辑</p>
    <h1>编辑工作台</h1>
    <p class="lede">
      内置 Markdown 编辑器会把修改提交成 GitHub Pull Request。合并 PR 后，站点才会发布对应内容。
    </p>
  </section>

  <section id="auth-panel" class="editor-panel auth-panel" aria-live="polite">
    <div>
      <p class="eyebrow">GitHub</p>
      <h2>编辑权限</h2>
      <p id="auth-status">正在检查 GitHub 登录状态...</p>
    </div>
    <div class="editor-actions auth-actions">
      <a id="github-login-link" class="button-link" href="/api/auth/github/login?returnTo=/editor/" hidden>
        使用 GitHub 登录
      </a>
      <a id="github-logout-link" class="button-link" href="/api/auth/github/logout?returnTo=/editor/" hidden>
        退出登录
      </a>
    </div>
  </section>

  <fieldset id="sviz-import-panel" class="editor-panel sviz-import-panel">
    <legend>添加 Demo</legend>
    <p class="meta">
      导入由 sviz <code>compile()</code> 生成的 JSON。提交内容 PR 时，编辑器会把 JSON 保存为站点资源。
    </p>
    <div class="sviz-import-actions">
      <button id="choose-sviz-json" type="button">添加 Demo</button>
      <input id="sviz-json-field" type="file" accept=".json,application/json" hidden />
      <button id="clear-sviz-import" class="subtle-button" type="button" hidden>移除 Demo</button>
    </div>
    <p id="sviz-import-status" class="meta" aria-live="polite">尚未选择文件。</p>
    <div id="sviz-import-details" class="sviz-import-details" hidden>
      <label>
        资源名称
        <input id="sviz-asset-slug-field" type="text" placeholder="demo-asset-name" />
      </label>
      <label class="wide">
        可复制的 Markdown 嵌入内容
        <textarea id="sviz-embed-snippet" rows="12" readonly spellcheck="false"></textarea>
      </label>
      <div class="editor-actions wide">
        <button id="copy-sviz-snippet" type="button">复制嵌入内容</button>
        <button id="insert-sviz-snippet" class="subtle-button" type="button">插入当前 Markdown</button>
      </div>
      <div id="sviz-import-preview" class="sviz-import-preview wide"></div>
    </div>
  </fieldset>

  <section
    id="existing-edit-section"
    aria-labelledby="existing-edit-title"
    class="editor-panel markdown-editor"
    data-editable-entries={JSON.stringify(editableEntries)}
    hidden
  >
    <p class="eyebrow">Edit Mode</p>
    <h2 id="existing-edit-title">编辑已有内容</h2>
    <p>
      从内容页面点击“编辑此页”后进入这里。保存草稿或发布都会创建/更新 GitHub PR，合并并部署后生效；转为草稿或待发布后，访客将无法访问该内容。
    </p>
    <p>
      当前正在编辑：<strong id="existing-entry-title">未选择内容</strong>
    </p>
    <p class="meta">
      源文件：<code id="existing-entry-source">未选择内容</code>
    </p>

    <div id="missing-entry-message" class="editor-notice" hidden>
      没有找到这个内容条目。请回到内容页重新点击“编辑此页”，或直接新建内容。
    </div>

    <div id="existing-conflict-message" class="editor-notice danger" hidden></div>

    <div class="markdown-tabs" role="tablist" aria-label="Markdown editor modes">
      <button id="markdown-edit-tab" class="tab-button active" type="button" role="tab" aria-selected="true">
        编辑
      </button>
      <button id="markdown-preview-tab" class="tab-button" type="button" role="tab" aria-selected="false">
        预览
      </button>
    </div>

    <div id="markdown-edit-pane" class="markdown-pane active" role="tabpanel" aria-labelledby="markdown-edit-tab">
      <textarea id="existing-markdown-editor" rows="22" spellcheck="false" disabled></textarea>
    </div>

    <div
      id="markdown-preview-pane"
      class="markdown-pane markdown-preview"
      role="tabpanel"
      aria-labelledby="markdown-preview-tab"
      hidden
    >
      <p class="meta">预览会渲染正文 Markdown，frontmatter 不参与渲染。MDX 组件语法会以普通文本或 HTML 形式保留。</p>
      <div id="markdown-preview-output" class="preview-surface"></div>
    </div>

    <div class="editor-actions">
      <button id="save-existing-draft-pr" type="button" disabled>保存草稿 PR</button>
      <button id="stage-existing-pr" type="button" disabled>暂存待发布 PR</button>
      <button id="publish-existing-pr" type="button" disabled>发布 PR</button>
      <a href="/editor/workspace/">内容工作台</a>
      <a href="https://app.pagescms.org/" target="_blank" rel="noreferrer">打开 Pages CMS</a>
      <a href="/editor/">新建内容</a>
      <a id="existing-pr-link" class="button-link subtle" href="#" target="_blank" rel="noreferrer" hidden>
        查看 PR
      </a>
      <span id="markdown-action-status" class="meta" aria-live="polite"></span>
    </div>
  </section>

  <section id="create-section" aria-labelledby="composer-title" class="editor-panel create-panel">
    <h2 id="composer-title">新建内容</h2>
    <p>
      先用表单生成 frontmatter 和 Markdown，再直接编辑生成结果。保存草稿或发布都会提交成 GitHub PR。
    </p>

    <form id="composer-form" class="composer-grid">
      <label>
        类型
        <select id="collection-field">
          <option value="posts">文章</option>
          <option value="notes">笔记</option>
        </select>
      </label>
      <label>
        状态
        <select id="status-field">
          <option value="draft">draft</option>
          <option value="staged">staged</option>
          <option value="published">published</option>
        </select>
      </label>
      <label>
        标题
        <input id="title-field" type="text" placeholder="内容标题" />
      </label>
      <label>
        Slug
        <input id="slug-field" type="text" placeholder="content-slug" />
      </label>
      <label>
        日期
        <input id="date-field" type="date" />
      </label>
      <label class="wide">
        摘要
        <textarea id="description-field" rows="2" placeholder="一句话说明内容价值"></textarea>
      </label>
      <label>
        作者 ID
        <input id="authors-field" type="text" value="owner" />
      </label>
      <label>
        标签
        <input id="tags-field" type="text" placeholder="astro, cms, demo" />
      </label>
      <label>
        格式
        <input id="formats-field" type="text" value="blog" />
      </label>
      <label class="wide">
        正文
        <textarea id="body-field" rows="8" placeholder="从这里开始写正文"></textarea>
      </label>
    </form>

    <label class="wide output-label">
      Markdown
      <textarea id="draft-output" rows="16" spellcheck="false" disabled></textarea>
    </label>

    <div id="draft-conflict-message" class="editor-notice danger" hidden></div>

    <div class="editor-actions">
      <button id="preview-draft-output" type="button">预览</button>
      <button id="save-draft-pr" type="button" disabled>保存草稿 PR</button>
      <button id="stage-draft-pr" type="button" disabled>暂存待发布 PR</button>
      <button id="publish-draft-pr" type="button" disabled>发布 PR</button>
      <a href="/editor/workspace/">内容工作台</a>
      <a href="https://app.pagescms.org/" target="_blank" rel="noreferrer">打开 Pages CMS</a>
      <a id="draft-pr-link" class="button-link subtle" href="#" target="_blank" rel="noreferrer" hidden>
        查看 PR
      </a>
      <span id="draft-action-status" class="meta" aria-live="polite"></span>
    </div>

    <div id="draft-preview-panel" class="draft-preview-panel" hidden>
      <h3>当前预览</h3>
      <p class="meta">预览会渲染正文 Markdown，frontmatter 不参与渲染。发布动作只会创建 PR。</p>
      <div id="draft-preview-output" class="preview-surface"></div>
    </div>
  </section>
</BaseLayout>

<script>
  import DOMPurify from "dompurify";
  import { marked } from "marked";
  import {
    MAX_SVIZ_JSON_BYTES,
    parseSvizDisplayJson,
    renderSvizMarkdownEmbed,
    slugifySvizAsset,
    type SvizDisplayDocument,
  } from "@/lib/svizImport";

  const collectionField = document.getElementById("collection-field") as HTMLSelectElement | null;
  const statusField = document.getElementById("status-field") as HTMLSelectElement | null;
  const titleField = document.getElementById("title-field") as HTMLInputElement | null;
  const slugField = document.getElementById("slug-field") as HTMLInputElement | null;
  const dateField = document.getElementById("date-field") as HTMLInputElement | null;
  const descriptionField = document.getElementById("description-field") as HTMLTextAreaElement | null;
  const authorsField = document.getElementById("authors-field") as HTMLInputElement | null;
  const tagsField = document.getElementById("tags-field") as HTMLInputElement | null;
  const formatsField = document.getElementById("formats-field") as HTMLInputElement | null;
  const bodyField = document.getElementById("body-field") as HTMLTextAreaElement | null;
  const output = document.getElementById("draft-output") as HTMLTextAreaElement | null;
  const previewDraftOutput = document.getElementById("preview-draft-output") as HTMLButtonElement | null;
  const saveDraftPr = document.getElementById("save-draft-pr") as HTMLButtonElement | null;
  const stageDraftPr = document.getElementById("stage-draft-pr") as HTMLButtonElement | null;
  const stageExistingPr = document.getElementById("stage-existing-pr") as HTMLButtonElement | null;
  const publishDraftPr = document.getElementById("publish-draft-pr") as HTMLButtonElement | null;
  const draftPreviewPanel = document.getElementById("draft-preview-panel") as HTMLElement | null;
  const draftPreviewOutput = document.getElementById("draft-preview-output");
  const draftActionStatus = document.getElementById("draft-action-status");
  const draftConflictMessage = document.getElementById("draft-conflict-message") as HTMLElement | null;
  const draftPrLink = document.getElementById("draft-pr-link") as HTMLAnchorElement | null;
  const chooseSvizJson = document.getElementById("choose-sviz-json") as HTMLButtonElement | null;
  const svizJsonField = document.getElementById("sviz-json-field") as HTMLInputElement | null;
  const clearSvizImport = document.getElementById("clear-sviz-import") as HTMLButtonElement | null;
  const svizImportStatus = document.getElementById("sviz-import-status");
  const svizImportDetails = document.getElementById("sviz-import-details") as HTMLElement | null;
  const svizAssetSlugField = document.getElementById("sviz-asset-slug-field") as HTMLInputElement | null;
  const svizEmbedSnippet = document.getElementById("sviz-embed-snippet") as HTMLTextAreaElement | null;
  const copySvizSnippet = document.getElementById("copy-sviz-snippet") as HTMLButtonElement | null;
  const insertSvizSnippet = document.getElementById("insert-sviz-snippet") as HTMLButtonElement | null;
  const svizImportPreview = document.getElementById("sviz-import-preview") as HTMLElement | null;
  const createSection = document.getElementById("create-section") as HTMLElement | null;
  const existingEditSection = document.getElementById("existing-edit-section") as HTMLElement | null;
  const editableRoot = existingEditSection;
  const missingEntryMessage = document.getElementById("missing-entry-message") as HTMLElement | null;
  const existingConflictMessage = document.getElementById("existing-conflict-message") as HTMLElement | null;
  const existingEntryTitle = document.getElementById("existing-entry-title");
  const existingEntrySource = document.getElementById("existing-entry-source");
  const existingMarkdownEditor = document.getElementById("existing-markdown-editor") as HTMLTextAreaElement | null;
  const markdownEditTab = document.getElementById("markdown-edit-tab") as HTMLButtonElement | null;
  const markdownPreviewTab = document.getElementById("markdown-preview-tab") as HTMLButtonElement | null;
  const markdownEditPane = document.getElementById("markdown-edit-pane") as HTMLElement | null;
  const markdownPreviewPane = document.getElementById("markdown-preview-pane") as HTMLElement | null;
  const markdownPreviewOutput = document.getElementById("markdown-preview-output");
  const saveExistingDraftPr = document.getElementById("save-existing-draft-pr") as HTMLButtonElement | null;
  const publishExistingPr = document.getElementById("publish-existing-pr") as HTMLButtonElement | null;
  const markdownActionStatus = document.getElementById("markdown-action-status");
  const existingPrLink = document.getElementById("existing-pr-link") as HTMLAnchorElement | null;
  const authStatus = document.getElementById("auth-status");
  const githubLoginLink = document.getElementById("github-login-link") as HTMLAnchorElement | null;
  const githubLogoutLink = document.getElementById("github-logout-link") as HTMLAnchorElement | null;

  const editableEntries = JSON.parse(editableRoot?.dataset.editableEntries ?? "[]") as Array<{
    id: string;
    collection: "posts" | "notes";
    slug: string;
    title: string;
    status: "draft" | "staged" | "published";
    sourcePath: string;
    markdown: string;
  }>;

  type EditorSession = {
    authenticated: boolean;
    csrfToken?: string;
    loginUrl?: string;
    logoutUrl?: string;
    user?: { login: string };
    repository?: { owner: string; repo: string; canPush?: boolean; visible?: boolean };
    configured?: boolean;
    missingEnv?: string[];
    error?: string;
  };

  type ContentResponse = {
    collection: "posts" | "notes";
    slug: string;
    path: string;
    sha: string;
    markdown: string;
  };

  let currentEditableEntryId = "";
  let currentExistingCollection: "posts" | "notes" | null = null;
  let currentExistingSlug = "";
  let currentExistingBaseSha: string | null = null;
  let sessionState: EditorSession | null = null;
  let slugTouched = false;
  let currentSvizDocument: SvizDisplayDocument | null = null;
  let currentSvizJson: string | null = null;
  let currentSvizPreviewUrl: string | null = null;
  let currentSvizAssetSlug = "";

  const today = new Date().toISOString().slice(0, 10);
  if (dateField) dateField.value = today;

  marked.setOptions({
    gfm: true,
    breaks: false,
  });

  function listFromInput(value: string) {
    return value
      .split(",")
      .map((item) => item.trim())
      .filter(Boolean);
  }

  function renderYamlList(items: string[]) {
    return items.length > 0 ? items.map((item) => `  - ${JSON.stringify(item)}`).join("\n") : '  - ""';
  }

  function slugify(value: string) {
    return (
      value
        .trim()
        .toLowerCase()
        .replace(/[^a-z0-9\u4e00-\u9fa5]+/g, "-")
        .replace(/^-+|-+$/g, "") || "untitled"
    );
  }

  function clearSvizPreviewUrl() {
    if (currentSvizPreviewUrl) URL.revokeObjectURL(currentSvizPreviewUrl);
    currentSvizPreviewUrl = null;
  }

  function appendSvizViewer(target: Element | null, src: string, visualizationId: string) {
    if (!target) return;
    const viewer = document.createElement("systems-viz-next");
    viewer.setAttribute("src", src);
    viewer.setAttribute("visualization-id", visualizationId);
    viewer.setAttribute("theme", "auto");
    target.append(viewer);
  }

  function renderSvizImportPreview() {
    if (!svizImportPreview) return;
    svizImportPreview.replaceChildren();
    if (!currentSvizDocument || !currentSvizPreviewUrl) return;
    appendSvizViewer(
      svizImportPreview,
      currentSvizPreviewUrl,
      currentSvizDocument.visualization_id,
    );
  }

  function resetSvizImport() {
    currentSvizDocument = null;
    currentSvizJson = null;
    currentSvizAssetSlug = "";
    clearSvizPreviewUrl();
    if (svizJsonField) svizJsonField.value = "";
    if (svizAssetSlugField) svizAssetSlugField.value = "";
    if (svizEmbedSnippet) svizEmbedSnippet.value = "";
    clearSvizImport?.toggleAttribute("hidden", true);
    svizImportDetails?.toggleAttribute("hidden", true);
    setNotice(svizImportStatus, "尚未选择文件。");
    renderSvizImportPreview();
  }

  function updateSvizSnippet() {
    if (!svizEmbedSnippet || !currentSvizDocument) return;
    currentSvizAssetSlug = slugifySvizAsset(
      svizAssetSlugField?.value ?? currentSvizDocument.visualization_id,
    );
    if (svizAssetSlugField) svizAssetSlugField.value = currentSvizAssetSlug;
    svizEmbedSnippet.value = renderSvizMarkdownEmbed({
      assetSlug: currentSvizAssetSlug,
      visualizationId: currentSvizDocument.visualization_id,
      caption: currentSvizDocument.title,
    });
  }

  async function importSvizFile(file: File) {
    if (file.size > MAX_SVIZ_JSON_BYTES) {
      throw new Error("sviz JSON 必须小于或等于 2 MiB。");
    }

    const document = parseSvizDisplayJson(await file.text());
    const canonicalJson = `${JSON.stringify(document, null, 2)}\n`;
    currentSvizDocument = document;
    currentSvizJson = canonicalJson;
    currentSvizAssetSlug = slugifySvizAsset(document.visualization_id);
    clearSvizPreviewUrl();
    currentSvizPreviewUrl = URL.createObjectURL(
      new Blob([canonicalJson], { type: "application/json" }),
    );

    if (svizAssetSlugField) svizAssetSlugField.value = currentSvizAssetSlug;
    updateSvizSnippet();
    svizImportDetails?.toggleAttribute("hidden", false);
    clearSvizImport?.toggleAttribute("hidden", false);
    setNotice(
      svizImportStatus,
      `已载入 ${file.name} · ${document.visualization_id} · ${document.display.views.length} 个视图`,
    );
    renderSvizImportPreview();
  }

  function setButtonsEnabled(enabled: boolean) {
    stageDraftPr?.toggleAttribute("disabled", !enabled);
    stageExistingPr?.toggleAttribute("disabled", !enabled);
    saveExistingDraftPr?.toggleAttribute("disabled", !enabled);
    publishExistingPr?.toggleAttribute("disabled", !enabled);
    saveDraftPr?.toggleAttribute("disabled", !enabled);
    publishDraftPr?.toggleAttribute("disabled", !enabled);
    existingMarkdownEditor?.toggleAttribute("disabled", !enabled);
    output?.toggleAttribute("disabled", !enabled);
  }

  function setNotice(target: Element | null, message: string, isError = false) {
    if (!target) return;
    target.textContent = message;
    target.classList.toggle("danger-text", isError);
  }

  function setConflict(target: HTMLElement | null, message = "") {
    if (!target) return;
    target.textContent = message;
    target.hidden = !message;
  }

  function setPrLink(target: HTMLAnchorElement | null, url?: string) {
    if (!target) return;
    if (!url) {
      target.hidden = true;
      target.href = "#";
      return;
    }
    target.href = url;
    target.hidden = false;
  }

  function updateAuthUi(session: EditorSession) {
    const returnTo = `${window.location.pathname}${window.location.search}`;
    if (githubLoginLink && session.loginUrl) {
      githubLoginLink.href = `/api/auth/github/login?returnTo=${encodeURIComponent(returnTo)}`;
    }
    if (githubLogoutLink && session.logoutUrl) {
      githubLogoutLink.href = `/api/auth/github/logout?returnTo=${encodeURIComponent(returnTo)}`;
    }

    githubLoginLink?.toggleAttribute("hidden", session.authenticated);
    githubLogoutLink?.toggleAttribute("hidden", !session.authenticated);

    if (session.configured === false) {
      setButtonsEnabled(false);
      githubLoginLink?.toggleAttribute("hidden", true);
      const missing = session.missingEnv?.join(", ") || "GitHub OAuth environment variables";
      setNotice(authStatus, `GitHub 编辑功能还没有配置。缺少：${missing}`, true);
      return;
    }

    if (!session.authenticated) {
      setButtonsEnabled(false);
      setNotice(authStatus, session.error ?? "请先使用 GitHub 登录，然后提交内容 PR。");
      return;
    }

    setButtonsEnabled(true);
    const repo = session.repository ? `${session.repository.owner}/${session.repository.repo}` : "GitHub repo";
    const target = session.repository?.canPush ? "源仓库分支" : "你的 fork";
    setNotice(authStatus, `已以 @${session.user?.login} 登录。提交会写入 ${target}，并向 ${repo} 创建 Pull Request。`);
  }

  async function loadSession() {
    try {
      const response = await fetch("/api/editor/session");
      const data = (await response.json()) as EditorSession;
      sessionState = data;
      updateAuthUi(data);
      return data;
    } catch {
      const fallback = {
        authenticated: false,
        error: "无法读取 GitHub 编辑会话，请刷新页面重试。",
      };
      sessionState = fallback;
      updateAuthUi(fallback);
      return fallback;
    }
  }

  function updateDraft() {
    if (!output) return;

    const collection = collectionField?.value ?? "posts";
    const title = titleField?.value.trim() || "Untitled";
    if (slugField && !slugTouched) slugField.value = slugify(title);
    const description = descriptionField?.value.trim() || "Draft description.";
    const pubDate = dateField?.value || today;
    const status = statusField?.value ?? "draft";
    const authors = listFromInput(authorsField?.value ?? "owner");
    const tags = listFromInput(tagsField?.value ?? "");
    const formats = listFromInput(formatsField?.value ?? (collection === "notes" ? "short" : "blog"));
    const body = bodyField?.value.trim() || "Write the content here.";

    const lines = [
      "---",
      `title: ${JSON.stringify(title)}`,
      `description: ${JSON.stringify(description)}`,
      `pubDate: ${pubDate}`,
      "authors:",
      renderYamlList(authors),
      "tags:",
      renderYamlList(tags),
      `status: "${status}"`,
    ];

    lines.push("formats:", renderYamlList(formats), "---", "", body);
    output.value = lines.join("\n");
    if (draftPreviewPanel && !draftPreviewPanel.hidden) updateDraftPreview();
  }

  function stripFrontmatter(markdown: string) {
    return markdown.replace(/^---\s*[\s\S]*?\s*---\s*/, "");
  }

  function stripSvizEmbed(markdown: string) {
    return markdown
      .replace(/<figure\b[^>]*class=["'][^"']*\bsviz-demo\b[^"']*["'][^>]*>[\s\S]*?<\/figure>/g, "")
      .replace(/<script\b[^>]*src=["'][^"']*systems-viz-next\.js["'][^>]*><\/script>/g, "");
  }

  function readSvizEmbed(markdown: string) {
    const webComponent = markdown.match(/<systems-viz-next\b[\s\S]*?<\/systems-viz-next>/)?.[0];
    if (webComponent) {
      const src = webComponent.match(/\bsrc=["']([^"']+)["']/)?.[1];
      const visualizationId = webComponent.match(/\bvisualization-id=["']([^"']+)["']/)?.[1];
      const caption = markdown.match(/<figcaption>([\s\S]*?)<\/figcaption>/)?.[1];
      if (src && visualizationId) return { src, visualizationId, caption };
    }

    return null;
  }

  function setMarkdownStatus(markdown: string, status: "draft" | "staged" | "published") {
    const frontmatterMatch = markdown.match(/^---\s*([\s\S]*?)\s*---/);
    if (!frontmatterMatch) return markdown;

    const frontmatter = frontmatterMatch[1] ?? "";
    const nextFrontmatter = /^status:\s*.*$/m.test(frontmatter)
      ? frontmatter.replace(/^status:\s*.*$/m, `status: "${status}"`)
      : `${frontmatter.trimEnd()}\nstatus: "${status}"`;

    return markdown.replace(/^---\s*[\s\S]*?\s*---/, `---\n${nextFrontmatter.trim()}\n---`);
  }

  function renderMarkdownPreview(markdown: string, target: Element | null) {
    if (!target) return;

    const embed = readSvizEmbed(markdown);
    const html = marked.parse(stripSvizEmbed(stripFrontmatter(markdown)), { async: false }) as string;
    target.innerHTML = DOMPurify.sanitize(html);
    if (embed) {
      const figure = document.createElement("figure");
      figure.className = "sviz-demo";
      const frame = document.createElement("div");
      frame.className = "sviz-demo-frame";
      figure.append(frame);
      appendSvizViewer(
        frame,
        currentSvizPreviewUrl ?? embed.src,
        currentSvizDocument?.visualization_id ?? embed.visualizationId,
      );
      if (embed.caption) {
        const caption = document.createElement("figcaption");
        caption.textContent = embed.caption;
        figure.append(caption);
      }
      target.append(figure);
    }
  }

  function updateDraftPreview() {
    if (!output) return;
    renderMarkdownPreview(output.value, draftPreviewOutput);
  }

  function showDraftPreview() {
    if (draftPreviewPanel) draftPreviewPanel.hidden = false;
    updateDraftPreview();
  }

  function getSelectedEditableEntry() {
    return editableEntries.find((entry) => entry.id === currentEditableEntryId);
  }

  function updateMarkdownPreview() {
    if (!existingMarkdownEditor || !markdownPreviewOutput) return;
    renderMarkdownPreview(existingMarkdownEditor.value, markdownPreviewOutput);
  }

  function setMarkdownMode(mode: "edit" | "preview") {
    const isPreview = mode === "preview";

    markdownEditTab?.classList.toggle("active", !isPreview);
    markdownPreviewTab?.classList.toggle("active", isPreview);
    markdownEditTab?.setAttribute("aria-selected", String(!isPreview));
    markdownPreviewTab?.setAttribute("aria-selected", String(isPreview));

    if (markdownEditPane) markdownEditPane.hidden = isPreview;
    if (markdownPreviewPane) markdownPreviewPane.hidden = !isPreview;

    if (isPreview) updateMarkdownPreview();
  }

  async function fetchExistingFromGitHub(entry: ReturnType<typeof getSelectedEditableEntry>) {
    if (!entry || !sessionState?.authenticated) return;
    setNotice(markdownActionStatus, "正在从 GitHub 读取最新内容...");

    const response = await fetch(`/api/editor/content/${entry.collection}/${encodeURIComponent(entry.slug)}`);
    const data = (await response.json()) as ContentResponse | { error: string };

    if (!response.ok) {
      setNotice(markdownActionStatus, "error" in data ? data.error : "无法读取 GitHub 内容。", true);
      return;
    }

    const content = data as ContentResponse;
    currentExistingBaseSha = content.sha;
    if (saveExistingDraftPr) {
      const published = /^status:\s*["']?published["']?\s*$/m.test(content.markdown.split(/^---\s*$/m)[1] ?? "");
      saveExistingDraftPr.textContent = published ? "转为草稿 PR / Return to draft" : "保存草稿 PR";
    }
    if (existingEntrySource) existingEntrySource.textContent = content.path;
    if (existingMarkdownEditor) existingMarkdownEditor.value = content.markdown;
    setNotice(markdownActionStatus, "已载入 GitHub 最新版本。");
    updateMarkdownPreview();
  }

  async function updateExistingEditor() {
    const entry = getSelectedEditableEntry();
    currentExistingBaseSha = null;
    setPrLink(existingPrLink);
    setConflict(existingConflictMessage);

    if (!entry) {
      if (missingEntryMessage) missingEntryMessage.hidden = false;
      if (existingMarkdownEditor) existingMarkdownEditor.value = "";
      if (existingEntryTitle) existingEntryTitle.textContent = "未找到内容";
      if (existingEntrySource) existingEntrySource.textContent = "未找到内容";
      return;
    }

    currentExistingCollection = entry.collection;
    currentExistingSlug = entry.slug;
    if (missingEntryMessage) missingEntryMessage.hidden = true;
    if (saveExistingDraftPr) saveExistingDraftPr.textContent = entry.status === "published" ? "转为草稿 PR / Return to draft" : "保存草稿 PR";
    if (existingEntryTitle) existingEntryTitle.textContent = entry.title;
    if (existingEntrySource) existingEntrySource.textContent = entry.sourcePath;
    if (existingMarkdownEditor) existingMarkdownEditor.value = entry.markdown;
    setNotice(markdownActionStatus, sessionState?.authenticated ? "" : "登录后会从 GitHub 读取最新文件并启用提交。");

    updateMarkdownPreview();
    await fetchExistingFromGitHub(entry);
  }

  function initializeEditorMode() {
    const entryId = new URLSearchParams(window.location.search).get("entry");

    if (!entryId) {
      if (createSection) createSection.hidden = false;
      if (existingEditSection) existingEditSection.hidden = true;
      return;
    }

    currentEditableEntryId = entryId;
    if (createSection) createSection.hidden = true;
    if (existingEditSection) existingEditSection.hidden = false;
  }

  async function submitProposal(input: {
    collection: string;
    slug?: string | null;
    markdown: string;
    baseSha?: string | null;
    svizJson?: string | null;
    svizAssetSlug?: string | null;
    intent: "draft" | "stage" | "publish";
    statusTarget: Element | null;
    conflictTarget: HTMLElement | null;
    linkTarget: HTMLAnchorElement | null;
  }) {
    if (!sessionState?.authenticated || !sessionState.csrfToken) {
      setNotice(input.statusTarget, "请先使用 GitHub 登录。", true);
      return;
    }

    setConflict(input.conflictTarget);
    setPrLink(input.linkTarget);
    setButtonsEnabled(false);
    setNotice(input.statusTarget, "正在提交到 GitHub...");

    try {
      const response = await fetch("/api/editor/proposals", {
        method: "POST",
        headers: {
          "content-type": "application/json",
          "x-csrf-token": sessionState.csrfToken,
        },
        body: JSON.stringify({
          collection: input.collection,
          slug: input.slug,
          markdown: input.markdown,
          svizJson: input.svizJson,
          svizAssetSlug: input.svizAssetSlug,
          baseSha: input.baseSha,
          intent: input.intent,
        }),
      });
      const data = (await response.json()) as { prUrl?: string; error?: string; path?: string; paths?: string[] };

      if (!response.ok) {
        const message = data.error ?? "GitHub 提交失败。";
        if (response.status === 409 || response.status === 202) {
          setConflict(input.conflictTarget, message);
        }
        setNotice(input.statusTarget, message, true);
        return;
      }

      setPrLink(input.linkTarget, data.prUrl);
      setNotice(input.statusTarget, `已创建/更新 PR。合并并完成部署后生效${input.intent === "publish" ? "，访客可见" : "，访客不可见"}。`);
    } catch {
      setNotice(input.statusTarget, "提交失败，请检查网络后重试。", true);
    } finally {
      setButtonsEnabled(Boolean(sessionState?.authenticated));
    }
  }

  document.getElementById("composer-form")?.addEventListener("input", updateDraft);
  chooseSvizJson?.addEventListener("click", () => svizJsonField?.click());
  svizJsonField?.addEventListener("change", async () => {
    const file = svizJsonField.files?.[0];
    if (!file) {
      resetSvizImport();
      return;
    }
    try {
      await importSvizFile(file);
    } catch (error) {
      resetSvizImport();
      setNotice(
        svizImportStatus,
        error instanceof Error ? error.message : "无法导入这个 sviz JSON。",
        true,
      );
    }
  });
  clearSvizImport?.addEventListener("click", resetSvizImport);
  svizAssetSlugField?.addEventListener("change", updateSvizSnippet);
  copySvizSnippet?.addEventListener("click", async () => {
    if (!svizEmbedSnippet?.value) return;
    try {
      await navigator.clipboard.writeText(svizEmbedSnippet.value);
      setNotice(svizImportStatus, "嵌入内容已复制。");
    } catch {
      svizEmbedSnippet.select();
      setNotice(svizImportStatus, "浏览器未允许自动复制；嵌入内容已选中，请手动复制。", true);
    }
  });
  insertSvizSnippet?.addEventListener("click", () => {
    const snippet = svizEmbedSnippet?.value;
    if (!snippet) return;

    if (existingEditSection && !existingEditSection.hidden && existingMarkdownEditor) {
      existingMarkdownEditor.value = `${existingMarkdownEditor.value.trimEnd()}\n\n${snippet}\n`;
      updateMarkdownPreview();
    } else if (bodyField) {
      bodyField.value = `${bodyField.value.trimEnd()}${bodyField.value.trim() ? "\n\n" : ""}${snippet}`;
      updateDraft();
    }
    setNotice(svizImportStatus, "嵌入内容已插入当前 Markdown。提交 PR 时会同时保存 JSON 资源。");
  });
  slugField?.addEventListener("input", () => {
    slugTouched = true;
  });
  titleField?.addEventListener("input", () => {
    if (!slugTouched && slugField) slugField.value = slugify(titleField.value);
  });
  output?.addEventListener("input", updateDraftPreview);
  updateDraft();

  existingMarkdownEditor?.addEventListener("input", updateMarkdownPreview);
  markdownEditTab?.addEventListener("click", () => setMarkdownMode("edit"));
  markdownPreviewTab?.addEventListener("click", () => setMarkdownMode("preview"));

  previewDraftOutput?.addEventListener("click", () => {
    showDraftPreview();
    setNotice(draftActionStatus, "已更新预览");
  });

  saveDraftPr?.addEventListener("click", () => {
    if (!output) return;
    output.value = setMarkdownStatus(output.value, "draft");
    if (statusField) statusField.value = "draft";
    submitProposal({
      collection: collectionField?.value ?? "posts",
      slug: slugField?.value.trim() || null,
      markdown: output.value,
      svizJson: currentSvizJson,
      svizAssetSlug: currentSvizAssetSlug || null,
      intent: "draft",
      statusTarget: draftActionStatus,
      conflictTarget: draftConflictMessage,
      linkTarget: draftPrLink,
    });
  });

  stageDraftPr?.addEventListener("click", () => {
    if (!output) return;
    output.value = setMarkdownStatus(output.value, "staged");
    if (statusField) statusField.value = "staged";
    submitProposal({
      collection: collectionField?.value ?? "posts",
      slug: slugField?.value.trim() || null,
      markdown: output.value,
      svizJson: currentSvizJson,
      svizAssetSlug: currentSvizAssetSlug || null,
      intent: "stage",
      statusTarget: draftActionStatus,
      conflictTarget: draftConflictMessage,
      linkTarget: draftPrLink,
    });
  });

  publishDraftPr?.addEventListener("click", () => {
    if (!output) return;
    output.value = setMarkdownStatus(output.value, "published");
    if (statusField) statusField.value = "published";
    showDraftPreview();
    submitProposal({
      collection: collectionField?.value ?? "posts",
      slug: slugField?.value.trim() || null,
      markdown: output.value,
      svizJson: currentSvizJson,
      svizAssetSlug: currentSvizAssetSlug || null,
      intent: "publish",
      statusTarget: draftActionStatus,
      conflictTarget: draftConflictMessage,
      linkTarget: draftPrLink,
    });
  });

  saveExistingDraftPr?.addEventListener("click", () => {
    if (!existingMarkdownEditor || !currentExistingCollection) return;
    existingMarkdownEditor.value = setMarkdownStatus(existingMarkdownEditor.value, "draft");
    updateMarkdownPreview();
    submitProposal({
      collection: currentExistingCollection,
      slug: currentExistingSlug,
      markdown: existingMarkdownEditor.value,
      baseSha: currentExistingBaseSha,
      svizJson: currentSvizJson,
      svizAssetSlug: currentSvizAssetSlug || null,
      intent: "draft",
      statusTarget: markdownActionStatus,
      conflictTarget: existingConflictMessage,
      linkTarget: existingPrLink,
    });
  });

  stageExistingPr?.addEventListener("click", () => {
    if (!existingMarkdownEditor || !currentExistingCollection) return;
    existingMarkdownEditor.value = setMarkdownStatus(existingMarkdownEditor.value, "staged");
    updateMarkdownPreview();
    submitProposal({
      collection: currentExistingCollection,
      slug: currentExistingSlug,
      markdown: existingMarkdownEditor.value,
      baseSha: currentExistingBaseSha,
      svizJson: currentSvizJson,
      svizAssetSlug: currentSvizAssetSlug || null,
      intent: "stage",
      statusTarget: markdownActionStatus,
      conflictTarget: existingConflictMessage,
      linkTarget: existingPrLink,
    });
  });

  publishExistingPr?.addEventListener("click", () => {
    if (!existingMarkdownEditor || !currentExistingCollection) return;
    existingMarkdownEditor.value = setMarkdownStatus(existingMarkdownEditor.value, "published");
    updateMarkdownPreview();
    submitProposal({
      collection: currentExistingCollection,
      slug: currentExistingSlug,
      markdown: existingMarkdownEditor.value,
      baseSha: currentExistingBaseSha,
      svizJson: currentSvizJson,
      svizAssetSlug: currentSvizAssetSlug || null,
      intent: "publish",
      statusTarget: markdownActionStatus,
      conflictTarget: existingConflictMessage,
      linkTarget: existingPrLink,
    });
  });

  initializeEditorMode();
  loadSession().then(() => {
    updateExistingEditor();
  });
</script>

