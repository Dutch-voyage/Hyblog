---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  getDraftEntries,
  getEntryEditHref,
  getEntrySourcePath,
} from "@/lib/content";

export const prerender = false;

const entry = (await getDraftEntries()).find(
  (entry) => entry.collection === Astro.params.collection && entry.id === Astro.params.slug,
);
if (!entry) return new Response("Not found", { status: 404 });
const { Content } = await render(entry);
const formattedDate = new Intl.DateTimeFormat("zh-CN", {
  dateStyle: "long",
}).format(entry.data.pubDate);
---

<BaseLayout title={`草稿预览：${entry.data.title}`} description={entry.data.description}>
  <article class="article">
    <aside class="draft-banner">
      <strong>{entry.data.status === "staged" ? "Staged preview" : "Draft preview"}</strong>
      <p>
        这是未发布内容，仅 GitHub 登录用户可见。
      </p>
      <p class="meta">源文件：<code>{getEntrySourcePath(entry)}</code></p>
      <p>
        <a class="edit-link" href={getEntryEditHref(entry)}>编辑内容</a> · <a href="/editor/workspace/">返回工作台</a>
      </p>
    </aside>

    <p class="meta">{formattedDate}</p>
    <h1>{entry.data.title}</h1>
    <p class="lede">{entry.data.description}</p>
    <ul class="tag-list" aria-label="Tags">
      {entry.data.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <Content />
  </article>
</BaseLayout>

<style>
  .draft-banner {
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--accent-soft);
    margin-bottom: 2rem;
    padding: 1rem;
  }

  .draft-banner p {
    margin-bottom: 0;
  }

  .edit-link {
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--background);
    display: inline-flex;
    font-weight: 800;
    margin-top: 0.75rem;
    padding: 0.45rem 0.85rem;
    text-decoration: none;
  }
</style>
