---
interface Props {
  src: string;
  visualizationId: string;
  caption: string;
}

const { src, visualizationId, caption } = Astro.props;
---

<figure class="sviz-embed">
  <div class="viewer-shell">
    <systems-viz-next
      src={src}
      visualization-id={visualizationId}
      theme="auto"
    ></systems-viz-next>
  </div>
  <figcaption>{caption}</figcaption>
  <noscript>此交互演示需要启用 JavaScript。</noscript>
</figure>

<script is:inline type="module" src="/demos/sviz/systems-viz-next.js"></script>

<style>
  .sviz-embed {
    position: relative;
    left: 50%;
    width: min(1120px, calc(100vw - 2rem));
    margin: 1.5rem 0 2rem;
    transform: translateX(-50%);
  }

  .viewer-shell {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
    box-shadow: 0 18px 50px color-mix(in srgb, var(--text), transparent 92%);
  }

  systems-viz-next {
    display: block;
    width: 100%;
    height: 720px;
    min-height: 620px;
  }

  figcaption,
  noscript {
    display: block;
    margin-top: 0.6rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 620px) {
    .sviz-embed {
      width: calc(100vw - 1rem);
    }

    systems-viz-next {
      height: auto;
      min-height: 680px;
    }
  }
</style>
